{
  "name": "m12r/typo3scan",
  "description": "TYPO3 scanner",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Michiel Roos",
      "email": "michiel@michielroos.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "m12r/typo3-cms-scanner": "dev-main",
    "symfony/process": "^7.4",
    "symfony/finder": "^7.4",
    "symfony/yaml": "^7.4",
    "twig/twig": "^v3.23",
    "symfony/console": "^7.4",
    "symfony/debug": "^4.4",
    "symfony/filesystem": "^7.4",
    "symfony/string": "^7.4"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/mschwemer/scanner"
    }
  ],
  "autoload": {
    "psr-4": {
      "M12R\\TYPO3Scan\\": "src/TYPO3Scan"
    }
  },
  "bin": [
    "bin/typo3scan",
    "typo3scan.phar"
  ],
  "config": {
    "bin-dir": "bin",
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "bamarni/composer-bin-plugin": "^1.8"
  },
  "scripts": {
    "build": "./bin/box compile && cp typo3scan.phar typo3scan",
    "prep": "cp typo3scan.phar typo3scan ../typo3scan"
  },
  "scripts-descriptions": {
    "build": "Build the typo3scan phar file",
    "prep": "Copy the phar files to the binary release repository that you have cloned into ../typo3scan"
  }
}
